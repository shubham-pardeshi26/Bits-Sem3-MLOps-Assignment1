# Grafana settings shared by Kubernetes (configMapGenerator "grafana-env") and docker-compose
# (env_file), so both stacks behave the same. The admin password is supplied separately.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/dashboards/cardiorisk-api.json
GF_LOG_MODE=console
GF_PLUGINS_PREINSTALL_DISABLED=true
